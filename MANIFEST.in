# SpecSpectacle - Source Distribution Manifest
# This file specifies additional files to include in the source distribution
# See: https://packaging.python.org/guides/using-manifest-in/

# Include top-level files
include README.md
include LICENSE
include CONTRIBUTING.md
include pyproject.toml
include requirements.txt
include requirements-dev.txt
include .env.example

# Include documentation
recursive-include docs *.md
recursive-include docs *.rst
recursive-include docs *.txt

# Include example files
recursive-include examples *.yaml
recursive-include examples *.yml
recursive-include examples README.md

# Include package data (if any)
recursive-include specspectacle *.json
recursive-include specspectacle *.yaml
recursive-include specspectacle *.yml

# Exclude development/build artifacts
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store
global-exclude *.egg-info
global-exclude .git
global-exclude .github
global-exclude .pytest_cache
global-exclude .coverage
global-exclude htmlcov
global-exclude .mypy_cache
global-exclude .tox
global-exclude .venv
global-exclude venv
global-exclude output
global-exclude *.mp4
global-exclude *.webm
global-exclude *.mp3
global-exclude *.wav
